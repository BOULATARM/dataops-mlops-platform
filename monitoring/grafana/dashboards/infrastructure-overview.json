          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|proc|sysfs\",mountpoint!~\"/(var/lib/(docker|containers)|run/docker|dev|proc|sys)($|/.*)\"} / (node_filesystem_size_bytes{job=\"node-exporter\",fstype!~\"tmpfs|devtmpfs|overlay|squashfs|nsfs|proc|sysfs\",mountpoint!~\"/(var/lib/(docker|containers)|run/docker|dev|proc|sys)($|/.*)\"} > 0))",
