  "panels": [
    {
      "id": 1,
      "title": "DataOps → ML lifecycle",
      "type": "text",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**dlt → DuckDB → dbt → Dagster → MLflow → modèle → monitoring / drift**\n\nDagster orchestre l’ingestion Bronze, les transformations Silver / Gold, le contrôle de dérive et l’entraînement. MLflow conserve les évaluations et le modèle chargé par FastAPI. Les observations ci-dessous proviennent uniquement de Prometheus."
      }
    },
    {
      "id": 2,
      "title": "Model",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      }
    },
    {
      "id": 3,
      "title": "Model loaded",
      "type": "stat",
      "description": "Model readiness, distinct from scrape availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "NOT LOADED",
                  "color": "red"
                },
                "1": {
                  "text": "LOADED",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
